generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id             Int                @id @default(autoincrement())
  nombre         String             @db.VarChar(100)
  apellido       String             @db.VarChar(100)
  correo         String             @unique @db.VarChar(255)
  contrasena     String             @db.VarChar(255)
  telefono       String?            @db.VarChar(20)
  rol            RolUsuario         @default(CLIENTE)
  activo         Boolean            @default(true)
  verificado     Boolean            @default(false)
  avatar         String?            @db.VarChar(500)
  creadoEn       DateTime           @default(now()) @map("creado_en")
  actualizadoEn  DateTime           @updatedAt @map("actualizado_en")
  direcciones    DireccionUsuario[]
  carrito        ItemCarrito[]
  wishlist       ItemWishlist[]
  notificaciones Notificacion[]
  pedidos        Pedido[]
  resenas        Resena[]
  tickets        TicketSoporte[]

  @@map("usuarios")
}

model DireccionUsuario {
  id             Int      @id @default(autoincrement())
  usuarioId      Int      @map("usuario_id")
  alias          String   @db.VarChar(50)
  nombreCompleto String   @map("nombre_completo") @db.VarChar(200)
  telefono       String   @db.VarChar(20)
  departamento   String   @db.VarChar(100)
  provincia      String   @db.VarChar(100)
  distrito       String   @db.VarChar(100)
  direccion      String   @db.VarChar(500)
  referencia     String?  @db.VarChar(300)
  predeterminada Boolean  @default(false)
  creadoEn       DateTime @default(now()) @map("creado_en")
  usuario        Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  pedidos        Pedido[]

  @@map("direcciones_usuario")
}

model Categoria {
  id               Int         @id @default(autoincrement())
  nombre           String      @db.VarChar(100)
  slug             String      @unique @db.VarChar(100)
  descripcion      String?
  imagen           String?
  categoriaPadreId Int?        @map("categoria_padre_id")
  activa           Boolean     @default(true)
  orden            Int         @default(0)
  creadoEn         DateTime    @default(now()) @map("creado_en")
  actualizadoEn    DateTime    @updatedAt @map("actualizado_en")
  categoriaPadre   Categoria?  @relation("SubCategorias", fields: [categoriaPadreId], references: [id])
  subcategorias    Categoria[] @relation("SubCategorias")
  productos        Producto[]

  @@map("categorias")
}

model Producto {
  id                    Int                    @id @default(autoincrement())
  nombre                String                 @db.VarChar(300)
  slug                  String                 @unique @db.VarChar(300)
  descripcion           String?
  descripcionCorta      String?                @map("descripcion_corta") @db.VarChar(500)
  categoriaId           Int                    @map("categoria_id")
  marcaId               Int?                   @map("marca_id")
  peso                  Decimal?               @db.Decimal(8, 3)
  dimensiones           Json?
  activo                Boolean                @default(true)
  destacado             Boolean                @default(false)
  calificacion          Decimal                @default(0) @db.Decimal(3, 2)
  totalResenas          Int                    @default(0) @map("total_resenas")
  totalVentas           Int                    @default(0) @map("total_ventas")
  imagenPrincipal       String?                @map("imagen_principal") @db.VarChar(500)
  creadoEn              DateTime               @default(now()) @map("creado_en")
  actualizadoEn         DateTime               @updatedAt @map("actualizado_en")
  imagenes              ImagenProducto[]       @relation("ImagenProducto_producto")
  itemsCarrito          ItemCarrito[]
  itemsOrdenCompra      ItemOrdenCompra[]
  itemsPedido           ItemPedido[]
  itemsWishlist         ItemWishlist[]
  movimientosInventario MovimientoInventario[]
  categoria             Categoria              @relation(fields: [categoriaId], references: [id])
  marca                 Marca?                 @relation(fields: [marcaId], references: [id])
  resenas               Resena[]
  variantes             VarianteProducto[]

  @@map("productos")
}

model ImagenProducto {
  id         Int               @id @default(autoincrement())
  productoId Int               @map("producto_id")
  url        String
  alt        String?           @db.VarChar(200)
  orden      Int               @default(0)
  principal  Boolean           @default(false)
  varianteId Int?              @map("variante_id")
  producto   Producto          @relation("ImagenProducto_producto", fields: [productoId], references: [id], onDelete: Cascade)
  variante   VarianteProducto? @relation("ImagenProducto_variante", fields: [varianteId], references: [id])

  @@map("imagenes_producto")
}

model VarianteProducto {
  id                    Int                    @id @default(autoincrement())
  productoId            Int                    @map("producto_id")
  stock                 Int                    @default(0)
  sku                   String                 @unique @db.VarChar(100)
  activo                Boolean                @default(true)
  colorId               Int?                   @map("color_id")
  enOferta              Boolean                @default(false) @map("en_oferta")
  porcentajeDescuento   Int?                   @default(0) @map("porcentaje_descuento")
  precioBase            Decimal                @map("precio_base") @db.Decimal(10, 2)
  precioOferta          Decimal?               @map("precio_oferta") @db.Decimal(10, 2)
  sizeId                Int?                   @map("size_id")
  stockMinimo           Int                    @default(5) @map("stock_minimo")
  esPrincipal           Boolean                @default(false) @map("es_principal")
  orden                 Int                    @default(0)
  imagenes              ImagenProducto[]       @relation("ImagenProducto_variante")
  itemsCarrito          ItemCarrito[]
  itemsOrdenCompra      ItemOrdenCompra[]
  itemsPedido           ItemPedido[]
  movimientosInventario MovimientoInventario[]
  color                 Color?                 @relation(fields: [colorId], references: [id])
  producto              Producto               @relation(fields: [productoId], references: [id], onDelete: Cascade)
  size                  Size?                  @relation(fields: [sizeId], references: [id])

  @@map("variantes_producto")
}

model Marca {
  id          Int        @id @default(autoincrement())
  nombre      String     @db.VarChar(100)
  slug        String     @unique @db.VarChar(100)
  logo        String?    @db.VarChar(500)
  descripcion String?
  activa      Boolean    @default(true)
  creadoEn    DateTime   @default(now()) @map("creado_en")
  productos   Producto[]

  @@map("marcas")
}

model Color {
  id            Int                @id @default(autoincrement())
  nombre        String             @db.VarChar(50)
  hex           String             @unique @db.VarChar(7)
  activo        Boolean            @default(true)
  creadoEn      DateTime           @default(now()) @map("creado_en")
  actualizadoEn DateTime           @updatedAt @map("actualizado_en")
  variantes     VarianteProducto[]

  @@map("colores")
}

model SizeCollection {
  id            Int      @id @default(autoincrement())
  nombre        String   @unique @db.VarChar(100)
  orden         Int      @default(0)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")
  tallas        Size[]   @relation("TallasColeccion")

  @@map("tallas_colecciones")
}

model Size {
  id            Int                @id @default(autoincrement())
  nombre        String             @db.VarChar(50)
  orden         Int                @default(0)
  activo        Boolean            @default(true)
  creadoEn      DateTime           @default(now()) @map("creado_en")
  actualizadoEn DateTime           @updatedAt @map("actualizado_en")
  coleccionId   Int?               @map("coleccion_id")
  coleccion     SizeCollection?    @relation("TallasColeccion", fields: [coleccionId], references: [id])
  variantes     VarianteProducto[]

  @@map("tallas")
}

model ItemCarrito {
  id         Int              @id @default(autoincrement())
  usuarioId  Int              @map("usuario_id")
  productoId Int              @map("producto_id")
  cantidad   Int              @default(1)
  creadoEn   DateTime         @default(now()) @map("creado_en")
  varianteId Int              @map("variante_id")
  producto   Producto         @relation(fields: [productoId], references: [id], onDelete: Cascade)
  usuario    Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  variante   VarianteProducto @relation(fields: [varianteId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, varianteId])
  @@map("items_carrito")
}

model ItemWishlist {
  id         Int      @id @default(autoincrement())
  usuarioId  Int      @map("usuario_id")
  productoId Int      @map("producto_id")
  creadoEn   DateTime @default(now()) @map("creado_en")
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, productoId])
  @@map("items_wishlist")
}

model Pedido {
  id              Int               @id @default(autoincrement())
  numeroPedido    String            @unique @map("numero_pedido") @db.VarChar(20)
  usuarioId       Int               @map("usuario_id")
  direccionId     Int?              @map("direccion_id")
  estado          EstadoPedido      @default(PENDIENTE)
  subtotal        Decimal           @db.Decimal(10, 2)
  descuento       Decimal           @default(0) @db.Decimal(10, 2)
  costoEnvio      Decimal           @default(0) @map("costo_envio") @db.Decimal(10, 2)
  impuestos       Decimal           @default(0) @db.Decimal(10, 2)
  total           Decimal           @db.Decimal(10, 2)
  metodoPago      MetodoPago        @default(TARJETA) @map("metodo_pago")
  estadoPago      EstadoPago        @default(PENDIENTE) @map("estado_pago")
  notas           String?
  fechaEntregaEst DateTime?         @map("fecha_entrega_est")
  fechaEntrega    DateTime?         @map("fecha_entrega")
  trackingCode    String?           @map("tracking_code") @db.VarChar(100)
  creadoEn        DateTime          @default(now()) @map("creado_en")
  actualizadoEn   DateTime          @updatedAt @map("actualizado_en")
  envio           EnvioPedido?
  historial       HistorialPedido[]
  items           ItemPedido[]
  direccion       DireccionUsuario? @relation(fields: [direccionId], references: [id])
  usuario         Usuario           @relation(fields: [usuarioId], references: [id])

  @@map("pedidos")
}

model ItemPedido {
  id         Int              @id @default(autoincrement())
  pedidoId   Int              @map("pedido_id")
  productoId Int              @map("producto_id")
  nombre     String           @db.VarChar(300)
  cantidad   Int
  precioUnit Decimal          @map("precio_unit") @db.Decimal(10, 2)
  subtotal   Decimal          @db.Decimal(10, 2)
  imagen     String?          @db.VarChar(500)
  varianteId Int              @map("variante_id")
  pedido     Pedido           @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto   Producto         @relation(fields: [productoId], references: [id])
  variante   VarianteProducto @relation(fields: [varianteId], references: [id])

  @@map("items_pedido")
}

model HistorialPedido {
  id          Int          @id @default(autoincrement())
  pedidoId    Int          @map("pedido_id")
  estado      EstadoPedido
  descripcion String       @db.VarChar(500)
  creadoEn    DateTime     @default(now()) @map("creado_en")
  pedido      Pedido       @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@map("historial_pedido")
}

model EnvioPedido {
  id              Int       @id @default(autoincrement())
  pedidoId        Int       @unique @map("pedido_id")
  transportista   String    @db.VarChar(100)
  codigoTracking  String    @map("codigo_tracking") @db.VarChar(100)
  estado          String    @db.VarChar(50)
  ubicacionActual String?   @map("ubicacion_actual") @db.VarChar(300)
  estimadoEntrega DateTime? @map("estimado_entrega")
  creadoEn        DateTime  @default(now()) @map("creado_en")
  actualizadoEn   DateTime  @updatedAt @map("actualizado_en")
  pedido          Pedido    @relation(fields: [pedidoId], references: [id])

  @@map("envios_pedido")
}

model Proveedor {
  id            Int           @id @default(autoincrement())
  nombre        String        @db.VarChar(200)
  ruc           String        @unique @db.VarChar(11)
  contacto      String?       @db.VarChar(100)
  correo        String?       @db.VarChar(255)
  telefono      String?       @db.VarChar(20)
  direccion     String?       @db.VarChar(500)
  pais          String        @default("Perú") @db.VarChar(100)
  activo        Boolean       @default(true)
  calificacion  Decimal       @default(5) @db.Decimal(3, 2)
  notas         String?
  creadoEn      DateTime      @default(now()) @map("creado_en")
  actualizadoEn DateTime      @updatedAt @map("actualizado_en")
  ordenesCompra OrdenCompra[]

  @@map("proveedores")
}

model OrdenCompra {
  id             Int               @id @default(autoincrement())
  numeroOrden    String            @unique @map("numero_orden") @db.VarChar(20)
  proveedorId    Int               @map("proveedor_id")
  estado         EstadoOrdenCompra @default(BORRADOR)
  subtotal       Decimal           @db.Decimal(10, 2)
  descuento      Decimal           @default(0) @db.Decimal(10, 2)
  total          Decimal           @db.Decimal(10, 2)
  fechaEsperada  DateTime?         @map("fecha_esperada")
  fechaRecepcion DateTime?         @map("fecha_recepcion")
  notas          String?
  creadoEn       DateTime          @default(now()) @map("creado_en")
  actualizadoEn  DateTime          @updatedAt @map("actualizado_en")
  items          ItemOrdenCompra[]
  proveedor      Proveedor         @relation(fields: [proveedorId], references: [id])

  @@map("ordenes_compra")
}

model ItemOrdenCompra {
  id               Int              @id @default(autoincrement())
  ordenCompraId    Int              @map("orden_compra_id")
  productoId       Int              @map("producto_id")
  cantidadPedida   Int              @map("cantidad_pedida")
  cantidadRecibida Int              @default(0) @map("cantidad_recibida")
  precioUnit       Decimal          @map("precio_unit") @db.Decimal(10, 2)
  subtotal         Decimal          @db.Decimal(10, 2)
  varianteId       Int              @map("variante_id")
  ordenCompra      OrdenCompra      @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)
  producto         Producto         @relation(fields: [productoId], references: [id])
  variante         VarianteProducto @relation(fields: [varianteId], references: [id])

  @@map("items_orden_compra")
}

model MovimientoInventario {
  id            Int              @id @default(autoincrement())
  productoId    Int              @map("producto_id")
  tipo          TipoMovimiento
  cantidad      Int
  stockAnterior Int              @map("stock_anterior")
  stockNuevo    Int              @map("stock_nuevo")
  motivo        String           @db.VarChar(300)
  referencia    String?          @db.VarChar(100)
  creadoEn      DateTime         @default(now()) @map("creado_en")
  varianteId    Int              @map("variante_id")
  producto      Producto         @relation(fields: [productoId], references: [id])
  variante      VarianteProducto @relation(fields: [varianteId], references: [id])

  @@map("movimientos_inventario")
}

model TicketSoporte {
  id            Int             @id @default(autoincrement())
  usuarioId     Int             @map("usuario_id")
  asunto        String          @db.VarChar(300)
  descripcion   String
  categoria     CategoriaTicket @default(CONSULTA)
  prioridad     PrioridadTicket @default(MEDIA)
  estado        EstadoTicket    @default(ABIERTO)
  creadoEn      DateTime        @default(now()) @map("creado_en")
  actualizadoEn DateTime        @updatedAt @map("actualizado_en")
  mensajes      MensajeTicket[]
  usuario       Usuario         @relation(fields: [usuarioId], references: [id])

  @@map("tickets_soporte")
}

model MensajeTicket {
  id       Int           @id @default(autoincrement())
  ticketId Int           @map("ticket_id")
  esAgente Boolean       @default(false) @map("es_agente")
  mensaje  String
  creadoEn DateTime      @default(now()) @map("creado_en")
  ticket   TicketSoporte @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("mensajes_ticket")
}

model Resena {
  id           Int      @id @default(autoincrement())
  usuarioId    Int      @map("usuario_id")
  productoId   Int      @map("producto_id")
  calificacion Int      @db.SmallInt
  titulo       String?  @db.VarChar(200)
  comentario   String?
  verificada   Boolean  @default(false)
  aprobada     Boolean  @default(true)
  creadoEn     DateTime @default(now()) @map("creado_en")
  producto     Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  usuario      Usuario  @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, productoId])
  @@map("resenas")
}

model Banner {
  id        Int      @id @default(autoincrement())
  titulo    String   @db.VarChar(200)
  subtitulo String?  @db.VarChar(300)
  imagen    String   @db.VarChar(500)
  enlace    String?  @db.VarChar(500)
  activo    Boolean  @default(true)
  orden     Int      @default(0)
  creadoEn  DateTime @default(now()) @map("creado_en")

  @@map("banners")
}

model Cupon {
  id          Int       @id @default(autoincrement())
  codigo      String    @unique @db.VarChar(50)
  descripcion String?   @db.VarChar(300)
  tipo        TipoCupon @default(PORCENTAJE)
  valor       Decimal   @db.Decimal(10, 2)
  minCompra   Decimal   @default(0) @map("min_compra") @db.Decimal(10, 2)
  usos        Int       @default(0)
  maxUsos     Int?      @map("max_usos")
  activo      Boolean   @default(true)
  fechaInicio DateTime  @default(now()) @map("fecha_inicio")
  fechaFin    DateTime? @map("fecha_fin")

  @@map("cupones")
}

model Notificacion {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @map("usuario_id")
  titulo    String   @db.VarChar(200)
  mensaje   String   @db.VarChar(500)
  tipo      String   @db.VarChar(50)
  leida     Boolean  @default(false)
  enlace    String?  @db.VarChar(300)
  creadoEn  DateTime @default(now()) @map("creado_en")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("notificaciones")
}

enum RolUsuario {
  ADMIN
  GERENTE
  OPERADOR
  CLIENTE
  PROVEEDOR

  @@map("rol_usuario")
}

enum EstadoPedido {
  PENDIENTE
  CONFIRMADO
  EN_PREPARACION
  ENVIADO
  EN_CAMINO
  ENTREGADO
  CANCELADO
  DEVUELTO

  @@map("estado_pedido")
}

enum EstadoPago {
  PENDIENTE
  PAGADO
  FALLIDO
  REEMBOLSADO

  @@map("estado_pago")
}

enum MetodoPago {
  TARJETA
  YAPE
  PLIN
  TRANSFERENCIA
  CONTRA_ENTREGA
  PAYPAL

  @@map("metodo_pago")
}

enum EstadoOrdenCompra {
  BORRADOR
  ENVIADA
  CONFIRMADA
  EN_TRANSITO
  RECIBIDA_PARCIAL
  RECIBIDA
  CANCELADA

  @@map("estado_orden_compra")
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
  AJUSTE
  DEVOLUCION

  @@map("tipo_movimiento")
}

enum CategoriaTicket {
  CONSULTA
  RECLAMO
  DEVOLUCION
  PAGO
  ENVIO
  PRODUCTO
  OTRO

  @@map("categoria_ticket")
}

enum PrioridadTicket {
  BAJA
  MEDIA
  ALTA
  URGENTE

  @@map("prioridad_ticket")
}

enum EstadoTicket {
  ABIERTO
  EN_ATENCION
  PENDIENTE_CLIENTE
  RESUELTO
  CERRADO

  @@map("estado_ticket")
}

enum TipoCupon {
  PORCENTAJE
  MONTO_FIJO

  @@map("tipo_cupon")
}
